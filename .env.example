# ═══════════════════════════════════════════════════
# Loan Streamline Pro (LSP) — Environment Variables
# ═══════════════════════════════════════════════════
# Copy this file to .env.local for local development, or add the same
# variables to the owner's Vercel project under Project Settings →
# Environment Variables.
#
# Never commit real credentials. .env* is ignored except this template.

# ───────────────────────────────────────────────────
# PostHog Analytics (optional)
# ───────────────────────────────────────────────────
NEXT_PUBLIC_POSTHOG_KEY=phc_your_key_here
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# ───────────────────────────────────────────────────
# Supabase
# Used for lead storage / PURL lookup / quote references.
# ───────────────────────────────────────────────────
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key

# SERVER-SIDE ONLY. Used by the personalized PURL lookup when RLS must
# be bypassed. Never expose this value in a NEXT_PUBLIC_* variable.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ───────────────────────────────────────────────────
# GoHighLevel (GHL)
# LSP uses the existing ADV company CRM infrastructure.
# Lead/PURL submissions are tagged: sms-web-purl-lsp
# ───────────────────────────────────────────────────
GHL_API_KEY=your-private-integration-token
GHL_LOCATION_ID=your-location-id

# Optional webhook routes. The direct Contacts API is currently enabled
# by the application; webhook support can be enabled/configured separately.
GHL_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-hook
GHL_QUALIFY_WEBHOOK_URL=https://services.leadconnectorhq.com/hooks/your-qualify-hook

# ───────────────────────────────────────────────────
# Salesforce
# Existing ADV Salesforce org / Connected App using OAuth2
# client_credentials flow.
# ───────────────────────────────────────────────────
SALESFORCE_INSTANCE_URL=https://your-instance.my.salesforce.com
SALESFORCE_CLIENT_ID=your-connected-app-client-id
SALESFORCE_CLIENT_SECRET=your-connected-app-client-secret

# Only needed if switching Salesforce to Web-to-Lead mode.
SALESFORCE_OID=your-org-id
